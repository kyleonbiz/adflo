# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required for real authentication, database and storage) -------
# Project Settings > API. Leave all three unset to run local development mode
# (in-memory sample data, no login; refused when NODE_ENV=production).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only. Used ONLY by the public /share/[token] route to resolve share
# links. Optional: without it, share links are disabled. NEVER prefix with
# NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret protecting /api/maintenance/cleanup-uploads (16+ random chars,
# e.g. `openssl rand -hex 24`). Without it the route answers 503. On Vercel, set it as a
# project env var and the bundled cron sends it automatically. Needs the service-role key.
CRON_SECRET=
# Pending uploads older than this many hours are removed by the cleanup route (min 3).
# DMS_PENDING_UPLOAD_MAX_AGE_HOURS=24

# --- Upload policy (optional) -------------------------------------------------
# Per-file limit in MB (default 50). The 'documents' bucket also enforces
# 50 MB; raise both together (see supabase/migrations/*_dms_storage.sql).
DMS_MAX_FILE_SIZE_MB=50
# Files per drop/selection (default 10).
DMS_MAX_FILES_PER_BATCH=10
# Restrict the built-in allow-list to these extensions (comma-separated).
# DMS_ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,jpg,jpeg,png
# Add types as ext=mime|mime;ext=mime. Also add the MIME type to the bucket's
# allowed_mime_types or Storage will reject the upload.
# DMS_EXTRA_FILE_TYPES=rtf=application/rtf

# --- Development mode ---------------------------------------------------------
# Development mode (in-memory data, no auth) only runs when Supabase is NOT
# configured and NODE_ENV != production. Setting this to "true" forces it on in
# production (e.g. a throwaway preview). Do not enable for real client data.
# DMS_ALLOW_DEV_MODE=false

# --- AI assistant (optional) ---------------------------------------------------
# Server-only. Without it the assistant answers with its built-in rules.
# ANTHROPIC_API_KEY=
# Model override (default claude-opus-5-5).
# ASSISTANT_MODEL=

# Where the landing page "Book a demo" form sends requests (opens the visitor's email app). Leave unset to disable the form.
NEXT_PUBLIC_SALES_EMAIL=

# Public https URL of the deployed app, no trailing slash (e.g. https://app.example.com). Password-reset emails link
# here instead of the request's origin. Also add it, plus /reset-password and /auth/callback, to Supabase's Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Content Security Policy for scripts (src/lib/csp.ts). "report-only" (default) logs violations in the browser console
# without blocking anything; "enforce" blocks scripts that lack the per-request nonce; "off" disables it.
# Try your real flows (sign-in, upload, document preview, authenticator setup) in report-only, then set enforce.
# CSP_MODE=enforce
