# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required for real authentication, database and storage) -------
# Project Settings > API. Leave all three unset to run local development mode
# (in-memory sample data, no login; refused when NODE_ENV=production).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only. Used ONLY by the public /share/[token] route to resolve share
# links. Optional: without it, share links are disabled. NEVER prefix with
# NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret protecting /api/maintenance/cleanup-uploads (16+ random chars,
# e.g. `openssl rand -hex 24`). Without it the route answers 503. On Vercel, set it as a
# project env var and the bundled cron sends it automatically. Needs the service-role key.
CRON_SECRET=
# Pending uploads older than this many hours are removed by the cleanup route (min 3).
# DMS_PENDING_UPLOAD_MAX_AGE_HOURS=24

# --- Upload policy (optional) -------------------------------------------------
# Per-file limit in MB (default 50). The 'documents' bucket also enforces
# 50 MB; raise both together (see supabase/migrations/*_dms_storage.sql).
DMS_MAX_FILE_SIZE_MB=50
# Files per drop/selection (default 10).
DMS_MAX_FILES_PER_BATCH=10
# Restrict the built-in allow-list to these extensions (comma-separated).
# DMS_ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,jpg,jpeg,png
# Add types as ext=mime|mime;ext=mime. Also add the MIME type to the bucket's
# allowed_mime_types or Storage will reject the upload.
# DMS_EXTRA_FILE_TYPES=rtf=application/rtf

# --- Development mode ---------------------------------------------------------
# Development mode (in-memory data, no auth) only runs when Supabase is NOT
# configured and NODE_ENV != production. Setting this to "true" forces it on in
# production (e.g. a throwaway preview). Do not enable for real client data.
# DMS_ALLOW_DEV_MODE=false

# Address that links sent to people (agreement, welcome, password reset, share links) are built on. On the live production site it
# defaults to https://www.adflo.pro; set this only to use a different address.
# NEXT_PUBLIC_SITE_URL=https://www.adflo.pro
# --- AI assistant (optional) ---------------------------------------------------
# Server-only. Without it the assistant answers with its built-in rules.
# ANTHROPIC_API_KEY=
# Model override (default claude-opus-5-5).
# ASSISTANT_MODEL=

# Landing page "Book a demo" form: the server emails each request through your Google Workspace mailbox.
# SMTP_USER is a Workspace address (e.g. sales@adflo.pro) and SMTP_PASSWORD is a Google app password for it (not the sign-in password).
# SMTP_USER=
# SMTP_PASSWORD=
# DEMO_REQUEST_TO=sales@adflo.pro
# DEMO_REQUEST_FROM=AdFlo <sales@adflo.pro>
# Onboarding emails (agreement links from the Control center) go out from this alias using the same SMTP account.
# In Google Workspace, add onboarding@adflo.pro under Gmail > Settings > Accounts > "Send mail as" for SMTP_USER, or Gmail will send from SMTP_USER itself.
# ONBOARDING_FROM=AdFlo Onboarding <onboarding@adflo.pro>
# Documents shared by email from the app come from this address ("Name via AdFlo"); default is the ONBOARDING_FROM address.
# SHARE_FROM=AdFlo <onboarding@adflo.pro>
# Who is told when a client accepts an agreement (default onboarding@adflo.pro, which lands in the SMTP mailbox).
# AGREEMENT_NOTIFY_TO=
# A daily job reminds clients who sat 3 days without signing up or accepting (max 3 automatic reminders each). Needs the SMTP and
# service-role settings above. ONBOARDING_AUTO_REMIND=off stops it; ONBOARDING_REMIND_AFTER_DAYS changes the 3 (1 to 60).
# ONBOARDING_AUTO_REMIND=on
# ONBOARDING_REMIND_AFTER_DAYS=3
